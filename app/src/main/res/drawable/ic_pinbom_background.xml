<?xml version="1.0" encoding="utf-8"?>
<!-- PinBom brand vector. Generated from brand/pinbom-glyph.svg — keep the two in sync. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Diagonal brand gradient #FF5A6A → #E60023 → #B3001B -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="108"
                android:endY="108"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="#FFFF5A6A" android:offset="0" />
                <item android:color="#FFE60023" android:offset="0.52" />
                <item android:color="#FFB3001B" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 13% white highlight in the top-start corner: makes the flat fill feel lit. -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="26"
                android:centerY="22"
                android:gradientRadius="86"
                android:type="radial">
                <item android:color="#21FFFFFF" android:offset="0" />
                <item android:color="#00FFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 12% bottom shade for weight. -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endY="108"
                android:startX="54"
                android:startY="46"
                android:endX="54"
                android:type="linear">
                <item android:color="#00000000" android:offset="0" />
                <item android:color="#1F000000" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
